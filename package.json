{
  "name": "claudart-insights",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local dashboard and CLI for your own Claude Code usage and cost",
  "license": "MIT",
  "engines": { "node": ">=25" },
  "exports": {
    "./src/*": "./src/*",
    "./dashboard/src/*": "./dashboard/src/*",
    "./dashboard/dist/*": "./dashboard/dist/*",
    "./package.json": "./package.json",
    "./test/fixtures/*": "./test/fixtures/*"
  },
  "scripts": {
    "start": "npm run build && node bin/insights.mjs serve",
    "dev": "vite dashboard",
    "build": "tsc --noEmit -p dashboard && vite build dashboard",
    "check": "tsc --noEmit -p dashboard",
    "test": "node --test"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
